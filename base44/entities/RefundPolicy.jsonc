// Global reference data: merchant/payment refund policies matched by refunds/scan.
// Readable by everyone; writes admin/service only. Seeded by scripts/seed-policies.ts.
{
  "name": "RefundPolicy",
  "type": "object",
  "title": "Refund Policy",
  "description": "A merchant or payment-rail refund policy rule",
  "properties": {
    "policy_key":      { "type": "string", "description": "Unique key, e.g. temu_on_time" },
    "merchant_domain": { "type": "string", "description": "Empty = generic policy (applies to any merchant)" },
    "rule_type": {
      "type": "string",
      "enum": ["late_delivery", "buyer_protection", "chargeback_window"]
    },
    "description":     { "type": "string", "description": "Shown in UI" },
    "window_days":     { "type": "integer", "description": "Claim window after promised/order date" },
    "claim_url":       { "type": "string", "description": "Where to file" }
  },
  "required": ["policy_key"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": true,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
