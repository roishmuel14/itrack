// One row per user: digest preferences + Gmail connection state.
// Created only by account/bootstrap; all writes via backend functions.
{
  "name": "UserSettings",
  "type": "object",
  "title": "User Settings",
  "description": "Per-user preferences and Gmail sync state",
  "properties": {
    "owner_email":        { "type": "string", "format": "email", "description": "Unique per user" },
    "digest_enabled":     { "type": "boolean", "default": true },
    "digest_hour_utc":    { "type": "integer", "minimum": 0, "maximum": 23, "default": 7 },
    "last_digest_date":   { "type": "string", "format": "date", "description": "UTC date of the last digest sent; hard once-per-day guard" },
    "gmail_connected":    { "type": "boolean", "default": false, "description": "Whether the user's own Gmail is connected (app-user connector)" },
    "last_gmail_sync_at": { "type": "string", "format": "date-time", "description": "Per-user incremental sync cursor" }
  },
  "required": ["owner_email"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.owner_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
