// One row per user. alias_token is THE routing key for inbound mail
// (itrackapp+<token>@gmail.com). Created only by account/bootstrap.
{
  "name": "UserSettings",
  "type": "object",
  "title": "User Settings",
  "description": "Per-user settings and the unique inbound-mail alias token",
  "properties": {
    "owner_email":          { "type": "string", "format": "email", "description": "Unique per user" },
    "alias_token":          { "type": "string", "minLength": 8, "description": "THE routing key; 8 lowercase alphanumerics, unique" },
    "digest_enabled":       { "type": "boolean", "default": true },
    "digest_hour_utc":      { "type": "integer", "minimum": 0, "maximum": 23, "default": 7 },
    "last_digest_date":     { "type": "string", "format": "date", "description": "UTC date of the last digest sent; hard once-per-day guard" },
    "forwarding_confirmed": { "type": "boolean", "default": false }
  },
  "required": ["owner_email", "alias_token"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.owner_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
