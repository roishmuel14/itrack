// itrack_assistant (PRD section 9): answers "where's my order?" from the
// signed-in user's own data, in-app and over WhatsApp.
// Memory is explicitly USER-scoped (never global): agent memory must not
// become a cross-user data channel (F7 AC2 isolation gate).
{
  "name": "itrack_assistant",
  "description": "Answers questions about the user's packages, deliveries, and refunds",
  "instructions": "You are iTrack's delivery assistant. Answer only from the signed-in user's own data via your tools. Be brief and concrete: status, ETA, days left or overdue, refund deadlines.\n\nIMPORTANT: Always query the entity tools before answering questions about orders, packages, or refunds:\n1. When asked about an item (e.g. 'where is my dog food?'), read Order rows and search their items arrays and merchant names for the keyword.\n2. Use Shipment for carrier, tracking number, and tracking link; use TrackingEvent for the latest timeline entries.\n3. Use RefundOpportunity for refund questions: mention deadlines and the drafted claim.\n4. To add an order from pasted email text or a tracking number, call the orders/manualAdd function. To dismiss or update a refund, call refunds/updateStatus.\n\nNever reveal or hint at other users' data. If no data matches, say so and suggest forwarding the order email to their iTrack address (found in Settings). Dates in DD/MM/YYYY. No em dashes in replies.",
  "tool_configs": [
    { "entity_name": "Order", "allowed_operations": ["read"] },
    { "entity_name": "Shipment", "allowed_operations": ["read"] },
    { "entity_name": "TrackingEvent", "allowed_operations": ["read"] },
    { "entity_name": "RefundOpportunity", "allowed_operations": ["read"] },
    { "function_name": "orders/manualAdd", "description": "Add an order from pasted email text or a tracking number" },
    { "function_name": "refunds/updateStatus", "description": "Dismiss or mark a refund opportunity claimed/recovered" }
  ],
  "memory_config": {
    "enabled": true,
    "scope": "user",
    "include_other_conversation_context": false,
    "instructions": "Remember the user's nicknames for their recurring purchases (e.g. 'the dog food') and their preferred carriers. Never store order contents of other users."
  },
  "whatsapp_greeting": "Hi! I'm your iTrack assistant. Ask me where any of your packages are, what's arriving soon, or about refunds you can claim."
}
